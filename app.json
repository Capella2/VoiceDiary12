{
  "expo": {
    "name": "VoiceDiary",
    "slug": "VoiceDiary",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "voicediary",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.voicediary.app",
      "newArchEnabled": true,
      "permissions": [
        "RECORD_AUDIO"
      ],
      "jsEngine": "hermes",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "navigationBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b7495c9-c802-4458-ad08-efde85be9b24"
      }
    },
    "owner": "capella2"
  }
}