{
  "expo": {
    "name": "VoiceDiary",
    "slug": "VoiceDiary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "voicediary",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.voicediary.app",
      "newArchEnabled": true,
      "permissions": [
        "RECORD_AUDIO"
      ],
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "navigationBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#ffffff"
      },
      "shortcuts": [
        {
          "id": "quick-record",
          "shortLabel": "Quick 6s Record",
          "longLabel": "Record a quick 6-second voice note",
          "icon": "./assets/images/icon.png",
          "intent": {
            "action": "android.intent.action.VIEW",
            "data": "voicediary://record?mode=quick"
          }
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b7495c9-c802-4458-ad08-efde85be9b24"
      }
    },
    "owner": "capella2"
  }
}
